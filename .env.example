VITE_AXIOM_ORGANIZATION_ID=test-org
VITE_ORGANIZATION_ID=test-org
VITE_AXIOM_WORKSPACE_ID=default
VITE_AXIOM_GATEWAY_API_URL=
VITE_DOCUMENT_API_BASE_URL=/api/document
VITE_CORPUS_API_BASE_URL=/api/corpus
# Browser requests use this Vite proxy path. Configure METHODS_HUB_PROXY_TARGET
# for the Vite server: http://localhost:38000 from the host, or
# http://methods-hub:8000 when the Vite server is in the same Docker network.
VITE_METHODS_HUB_API_BASE_URL=/methods-hub
METHODS_HUB_PROXY_TARGET=http://localhost:38000
# Optional for local Vite development: the proxy adds this to Methods-Hub PATCH
# requests without exposing it to the browser. Use a BFF in deployed environments.
METHOD_HUB_ADMIN_TOKEN=
VITE_MEMORY_API_BASE_URL=/api/v1
# Optional. Set only when a ReMe service is running, e.g. http://127.0.0.1:2333
VITE_REME_API_BASE_URL=
VITE_MEMORY_TENANT_ID=test-org
# Base only; Model Service API version is centralized in modelServiceContract.ts.
VITE_MODEL_SERVICE_API_BASE_URL=/model-service
VITE_MODEL_SERVICE_PROXY_TARGET=http://localhost:8007
